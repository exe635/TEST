local MainLoopThread = nil
local loopCounter = 0

function StartMainLoop()
    if IsScriptRunning then
        print("Script déjà en cours, ignoré - Script already running, ignored.")
        return
    end
    
    if IsRestarting then
        print("Redémarrage en cours, ignoré - restart in progress, ignored.")
        return
    end
    
    if IsCharacterChanging then
        print("Changement de personnage en cours, ignoré - Changing character in progress, ignored.")
        return
    end
    
    if not IsCharacterLoaded() then
        print("Personnage non chargé, attente... - character not loaded, waiting...")
        return
    end
    
    IsScriptRunning = true
    IsDead = false
    _G.NeedRestart = false
    
    print("Script démarré - Script started.")
    
    if MainLoopThread then
        task.cancel(MainLoopThread)
        MainLoopThread = nil
    end
    
    MainLoopThread = task.spawn(function()
        loopCounter = 0
        _G.TMMXFarm = true
        
        -- BOUCLE PRINCIPALE - AUCUN DELAI
        while (_G.TMMXFarm) do
            -- SEUL Heartbeat:Wait() EST OBLIGATOIRE
            RunService.Heartbeat:Wait()
            
            -- APPEL DIRECT - PAS DE pcall POUR VITESSE
            FarmGift()
            
            loopCounter = loopCounter + 1
            
            -- Statistiques tous les 10 tours (pas de délai)
            if loopCounter % 10 == 0 then
                GetCoins()
            end
            
            -- Rapport toutes les 30 secondes (pas de délai)
            if loopCounter % 30 == 0 then
                if tick() - Stats.LastReportTime >= 300 then
                    SendPeriodicReport(false)
                end
            end
        end
        
        IsScriptRunning = false
        MainLoopThread = nil
        print("Script arrêté. - Script stopped.")
    end)
end

