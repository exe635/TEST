local function IsNetworkErrorType(errorMessage)
    local networkKeywords = {
        "connection lost", "lost connection", "lost connection to the game server",
        "error code: 277", "277", "network", "internet", "offline",
        "timeout", "timed out", "no connection", "connection closed",
        "reset by peer", "broken pipe", "server unavailable",
        "cannot connect", "connection refused", "network unreachable",
        "failed to connect", "disconnected", "reconnect", "connection error"
    }
    
    for _, keyword in ipairs(networkKeywords) do
        if string.find(string.lower(errorMessage), string.lower(keyword)) then
            return true
        end
    end
    return false
end

local function IsClientInitiatedDisconnect(errorMessage)
    local clientKeywords = {
        "client initiated disconnect", "client initiated", "client disconnected",
        "you left", "you have left", "disconnect requested",
        "user initiated", "user requested", "you disconnected",
        "you have disconnected"
    }
    
    for _, keyword in ipairs(clientKeywords) do
        if string.find(string.lower(errorMessage), string.lower(keyword)) then
            return true
        end
    end
    return false
end

local function IsKick(errorMessage)
    local kickKeywords = {
        "kicked", "you have been kicked", "you were kicked",
        "banned", "you have been banned", "you were banned",
        "removed from the game", "you have been removed",
        "moderated", "you have been moderated",
        "exploit", "cheating", "you are not allowed"
    }
    
    for _, keyword in ipairs(kickKeywords) do
        if string.find(string.lower(errorMessage), string.lower(keyword)) then
            return true
        end
    end
    return false
end

