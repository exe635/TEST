local function RejoinGame(reason)
    if IsReconnecting then return end
    if RejoinCooldown then 
        print("⏳ Cooldown de reconnection en cours...")
        return 
    end
    
    IsReconnecting = true
    RejoinAttempts = RejoinAttempts + 1
    Stats.RejoinCount = (Stats.RejoinCount or 0) + 1
    
    local reasonText = reason == "kick" and "KICK" or "ERREUR RÉSEAU"
    print(string.format("🔄 %s - Reconnection %d/%d", reasonText, RejoinAttempts, MaxRejoinAttempts))
    
    SendWebhook(
        string.format("🔄 %s - Tentative %d/%d", reasonText, RejoinAttempts, MaxRejoinAttempts),
        WebhookConfig.Colors.Rejoin,
        "🔄 Reconnection",
        nil,
        WebhookConfig.PingConfig.OnRejoin
    )
    
    if RejoinAttempts >= MaxRejoinAttempts then
        SendWebhook(
            "❌ Échec après " .. MaxRejoinAttempts .. " tentatives. Arrêt du script.",
            WebhookConfig.Colors.Error,
            "❌ Échec Critique",
            nil,
            WebhookConfig.PingConfig.OnRejoinFail
        )
        IsReconnecting = false
        IsScriptRunning = false
        _G.TMMXFarm = false
        return
    end
    
    -- Désactiver temporairement le script
    IsScriptRunning = false
    if MainLoopThread then
        task.cancel(MainLoopThread)
        MainLoopThread = nil
    end
    
    IsDead = true;
    
    -- Attendre que le joueur soit bien mort avant de teleporter
    task.wait(2)
    
    local success = pcall(function()
        TeleportService:Teleport(game.PlaceId, Player)
    end)
    
    if not success then
        print("❌ Échec du téléport, nouvelle tentative dans 5 secondes...")
        IsReconnecting = false
        RejoinCooldown = true
        task.wait(5)
        RejoinCooldown = false
        RejoinGame(reason)
    else
        print("✅ Téléportation déclenchée...")
        IsNetworkError = false
        ReconnectAttempted = false
        -- La connexion CharacterAdded va gérer la suite
    end
end

