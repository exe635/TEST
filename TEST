local function HandleDeath()
    if IsDead or IsReconnecting then return end
    
    local currentTime = tick()
    -- Éviter les morts en boucle (cooldown de 2 secondes)
    if currentTime - LastDeathTime < 2 then return end
    LastDeathTime = currentTime
    
    IsDead = true
    Stats.DeathCount = (Stats.DeathCount or 0) + 1
    
    print("💀 Joueur mort ! Le script attend le respawn... (PAS de rejoin)")
    
    -- PAS DE REJOIN POUR LES MORTS - On attend juste le respawn
end

-- ============================================
-- FONCTION PRINCIPALE DE FARM
-- ============================================

local function FarmGift()
    -- Vérification de l'état du personnage
    local char = Player.Character
    if not char then 
        print("⚠️ Personnage inexistant, attente...")
        return 
    end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    -- Vérifier si le joueur est mort
    if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
        HandleDeath()
        return
    end
    
    -- Si on est en train de se reconnecter, on attend
    if IsReconnecting then
        task.wait(1)
        return
    end
    
    -- Vérifier si le personnage est chargé
    if not char:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    -- Vérifier si le joueur est en train de tomber (mort imminente)
    if humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
        print("⚠️ Joueur en train de tomber, surveillance...")
        task.wait(0.5)
        if humanoid.Health <= 0 then
            HandleDeath()
        end
        return
    end
    
    -- Si le joueur était mort mais est revenu
    if IsDead then
        IsDead = false
        IsReconnecting = false
        RejoinAttempts = 0
        print("✅ Joueur réanimé !")
        SendWebhook(
            "✅ Joueur réanimé !",
            WebhookConfig.Colors.Success,
            "✅ Réanimation",
            nil,
            false
        )
    end
    
    -- Rechercher et collecter le cadeau
    local Gift = GetNearestGift();
    if not Gift then 
        return; 
    end;
    
    local HitDetect = Gift:FindFirstChild("HitDetect") or Gift:FindFirstChild("Highlight");
    if not HitDetect or not HitDetect:IsA("BasePart") then 
        return; 
    end;
    
    if (Goto(HitDetect.Position, Gift) and Gift.Name ~= "GiftPrefab") then
        Stats.GiftsCollected = Stats.GiftsCollected + 1
        Stats.GiftsThisPeriod = Stats.GiftsThisPeriod + 1
        wait(3);
    end;
end;

-- ============================================
-- BOUCLE PRINCIPALE
-- ============================================

local function StartMainLoop()
    if IsScriptRunning then
        return
    end
    
    -- Vérifier que le personnage est valide avant de démarrer
    if not IsCharacterLoaded() then
        print("⚠️ Personnage non chargé, attente...")
        return
    end
    
    IsScriptRunning = true
    _G.TMMXFarm = true;
    IsDead = false
    IsReconnecting = false
    RejoinAttempts = 0
    
    print("✅ Script démarré !")
    
    -- Afficher le temps restant avant le prochain rapport
    local timeSinceLastReport = tick() - Stats.LastReportTime
    if timeSinceLastReport < 300 then
        local timeLeft = 300 - timeSinceLastReport
        print(string.format("⏳ Prochain rapport dans %.0f secondes", timeLeft))
    else
        print("⏳ Un rapport va être envoyé prochainement")
    end
    
    if MainLoopThread then
        task.cancel(MainLoopThread)
        MainLoopThread = nil
    end
    
    MainLoopThread = task.spawn(function()
        local loopCount = 0
        while (_G.TMMXFarm and IsScriptRunning) do
            RunService.Heartbeat:Wait();
            
            -- Si on est en reconnection, on attend
            if IsReconnecting then
                task.wait(0.5)
                continue
            end
            
            -- Vérifier si le joueur existe toujours
            if not Players:FindFirstChild(Player.Name) then
                print("🚪 Joueur disparu - Reconnection...")
                RejoinGame("kick")
                continue
            end
            
            -- Exécuter le farm avec gestion d'erreur
            local success, err = pcall(FarmGift);
            if not success then
                print("❌ Erreur FarmGift:", err)
                task.wait(1)
            end
            
            -- METTRE À JOUR LES PIÈCES RÉGULIÈREMENT
            if loopCount % 10 == 0 then
                GetCoins()
            end
            
            loopCount = loopCount + 1
            
            -- Vérifier si 5 minutes se sont écoulées
            if tick() - Stats.LastReportTime >= 300 then
                SendPeriodicReport(false)
            end
        end
        IsScriptRunning = false
    end)
end

local function StopScript()
    print("🛑 Arrêt du script...")
    IsScriptRunning = false
    IsDead = false
    _G.TMMXFarm = false
    
    if MainLoopThread then
        task.cancel(MainLoopThread)
        MainLoopThread = nil
    end
    
    print("✅ Script arrêté")
    print(string.format("📊 Stats sauvegardées: %d cadeaux au total", Stats.GiftsCollected))
end

local function RestartScript()
    print("🔄 Redémarrage du script...")
    StopScript()
    task.wait(1)
    
    -- Attendre que le personnage soit chargé
    local attempts = 0
    while attempts < 30 and not IsCharacterLoaded() do
        task.wait(0.2)
        attempts = attempts + 1
    end
    
    if IsCharacterLoaded() then
        StartMainLoop()
    else
        print("⚠️ Impossible de redémarrer, personnage non chargé")
        -- Le CharacterAdded va gérer le redémarrage
    end
end

-- ============================================
-- GESTION CHARACTERADDED
-- ============================================

local function OnCharacterAdded(character)
    print("🔄 Nouveau personnage détecté !")
    IsDead = false
    IsReconnecting = false
    RejoinAttempts = 0
    IsNetworkError = false
    ReconnectAttempted = false
    
    -- Nettoyer l'ancienne connexion de mort
    if Connections.HumanoidDied then
        pcall(function()
            Connections.HumanoidDied:Disconnect()
        end)
        Connections.HumanoidDied = nil
    end
    
    -- Attendre que le personnage soit complètement chargé
    local attempts = 0
    while attempts < 50 do
        task.wait(0.1)
        attempts = attempts + 1
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid and humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") then
            break
        end
    end
    
    if IsCharacterLoaded() then
        print("✅ Personnage prêt !")
        
        -- Configurer la détection de mort sur le nouveau personnage
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            Connections.HumanoidDied = humanoid.Died:Connect(function()
                print("💀 Événement Died déclenché !")
                HandleDeath()
            end)
        end
        
        task.wait(1)
        RestartScript()
    else
        print("⚠️ Personnage non complètement chargé")
    end
end

local function SetupCharacterAdded()
    if not Player then
        print("⚠️ Player n'est pas disponible, attente...")
        task.wait(1)
        return SetupCharacterAdded()
    end
    
    if Connections.CharacterAdded then
        pcall(function()
            Connections.CharacterAdded:Disconnect()
        end)
        Connections.CharacterAdded = nil
    end
    
    Connections.CharacterAdded = Player.CharacterAdded:Connect(OnCharacterAdded)
    
    print("✅ CharacterAdded configuré !")
end

