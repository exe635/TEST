    GuiService.ErrorMessageChanged:Connect(function(errorMessage)
        if errorMessage and errorMessage ~= "" then
            local kickKeywords = {"kicked", "banned", "removed from the game"}
            for _, keyword in ipairs(kickKeywords) do
                if string.find(string.lower(errorMessage), string.lower(keyword)) then
                    print("🚪 KICK DÉTECTÉ !")
