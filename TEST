-- BOUCLE PRINCIPALE DE FARM
-- ============================================

function StartMainLoop()
    if IsScriptRunning then
        return
    end
    
    if not IsCharacterLoaded() then
        print("⚠️ Personnage non chargé, attente...")
        return
    end
    
    IsScriptRunning = true
    IsDead = false
    
    print("✅ Script démarré !")
    
    local timeSinceLastReport = tick() - Stats.LastReportTime
    if timeSinceLastReport < 300 then
        local timeLeft = 300 - timeSinceLastReport
        print(string.format("⏳ Prochain rapport dans %.0f secondes", timeLeft))
    else
        print("⏳ Un rapport va être envoyé prochainement")
    end
    
    task.spawn(function()
        local loopCount = 0
        while IsScriptRunning do
            RunService.Heartbeat:Wait();
            
            if not Players:FindFirstChild(Player.Name) then
                print("🚪 Joueur disparu - Arrêt du script")
                IsScriptRunning = false
                break
            end
            
            local success, err = pcall(FarmGift);
            if not success then
                if not string.find(tostring(err), "PathfindingService") then
                    print("❌ Erreur FarmGift:", err)
                end
                task.wait(1)
            end
            
            if loopCount % 10 == 0 then
                GetCoins()
            end
            
            loopCount = loopCount + 1
            
            if tick() - Stats.LastReportTime >= 300 then
                SendPeriodicReport(false)
            end
        end
        IsScriptRunning = false
        print("🛑 Script arrêté")
    end)
end

function StopScript()
    print("🛑 Arrêt du script...")
    IsScriptRunning = false
    IsDead = false
    print("✅ Script arrêté")
    print(string.format("📊 Stats sauvegardées: %d cadeaux au total", Stats.GiftsCollected))
end

function RestartScript()
    print("🔄 Redémarrage du script...")
    StopScript()
    task.wait(1)
    
    local attempts = 0
    while attempts < 30 and not IsCharacterLoaded() do
        task.wait(0.2)
        attempts = attempts + 1
    end
    
    if IsCharacterLoaded() then
        StartMainLoop()
    else
        print("⚠️ Impossible de redémarrer")
    end
end

