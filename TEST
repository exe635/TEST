-- Variables pour l'auto-rejoin
local RejoinActive = true
local IsReconnecting = false
local RejoinAttempts = 0
local LastRejoinTime = 0
local RejoinDelay = 5
local LastPopupCheck = 0
local PopupCheckCooldown = 0.3
local CachedPopup = false

-- ============================================
-- DÉTECTION DE DÉCONNEXION
-- ============================================

local function HasSystemError()
    local guiService = GuiService
    if guiService then
        local errorMessage = guiService:FindFirstChild("ErrorMessage")
        if errorMessage and errorMessage:IsA("TextLabel") then
            local text = errorMessage.Text or ""
            if text ~= "" then
                return true
            end
        end
    end
    
    local coreGui = CoreGui
    if coreGui then
        local errorMsg = coreGui:FindFirstChild("ErrorMessage")
        if errorMsg and errorMsg:IsA("TextLabel") then
            local text = errorMsg.Text or ""
            if text ~= "" then
                return true
            end
        end
    end
    
    return false
end

local function HasTeleportFailedPopup()
    local coreGui = CoreGui
    if not coreGui then
        return false
    end
    
    local function searchForError(instance)
        if not instance then return false end
        if instance:IsA("TextLabel") then
            local text = instance.Text or ""
            if string.find(string.lower(text), "teleport failed") or
               string.find(string.lower(text), "connection failed") or
               string.find(string.lower(text), "error code") or
               string.find(string.lower(text), "lost connection") then
                return true
            end
        end
        for _, child in ipairs(instance:GetChildren()) do
            if searchForError(child) then
                return true
            end
        end
        return false
    end
    
    return searchForError(coreGui)
end

local function HasErrorPopup()
    local now = tick()
    if now - LastPopupCheck < PopupCheckCooldown then
        return CachedPopup
    end
    LastPopupCheck = now
    
    if HasSystemError() or HasTeleportFailedPopup() then
        CachedPopup = true
        return true
    end
    
    CachedPopup = false
    return false
end

local function IsOnDisconnectScreen()
    local coreGui = CoreGui
    if not coreGui then
        return false
    end
    
    local robloxGui = coreGui:FindFirstChild("RobloxGui")
    if robloxGui and robloxGui:IsA("ScreenGui") then
        if robloxGui:FindFirstChild("DisconnectFrame") or
           robloxGui:FindFirstChild("ReconnectFrame") or
           robloxGui:FindFirstChild("ConnectionLost") or
           robloxGui:FindFirstChild("LeaveButton") or
           robloxGui:FindFirstChild("ReconnectButton") then
            return true
        end
    end
    
    return false
end

local function IsPlayerGone()
    return not Players:FindFirstChild(Player.Name)
end

local function IsDisconnected()
    if IsOnDisconnectScreen() then
        return true
    end
    if IsPlayerGone() then
        return true
    end
    if HasErrorPopup() then
        return true
    end
    if not Workspace or not Workspace.Parent then
        return true
    end
    return false
end

-- ============================================
-- FONCTION REJOIN
-- ============================================

local function Rejoin()
    if IsReconnecting then
        print("⏳ Déjà en reconnection...")
        return false
    end
    
    if not RejoinActive then
        return false
    end
    
    if tick() - LastRejoinTime < RejoinDelay then
        print(string.format("⏳ Cooldown: %.1f secondes", RejoinDelay - (tick() - LastRejoinTime)))
        return false
    end
    
    IsReconnecting = true
    RejoinAttempts = RejoinAttempts + 1
    LastRejoinTime = tick()
    
    print(string.format("🔄 Reconnection - Tentative %d", RejoinAttempts))
    print("📡 Téléportation vers le jeu...")
    
    SendWebhook(
        string.format("🔄 **Tentative de reconnection #%d**", RejoinAttempts),
        WebhookConfig.Colors.Rejoin,
        "🔄 Reconnection",
        nil,
        WebhookConfig.PingConfig.OnRejoin
    )
    
    task.wait(1)
    
    local success, err = pcall(function()
        TeleportService:Teleport(game.PlaceId, Player)
    end)
    
    if not success then
        print("❌ Échec du téléport:", err)
        IsReconnecting = false
        task.wait(3)
        return Rejoin()
    end
    
    print("✅ Téléportation déclenchée")
    print("⏳ Attente du chargement...")
    
    local waitTime = 0
    local maxWait = 40
    
    while waitTime < maxWait do
        task.wait(0.5)
        waitTime = waitTime + 1
        
        if HasErrorPopup() then
            print("⚠️ Popup d'erreur détecté")
            IsReconnecting = false
            task.wait(2)
            return Rejoin()
        end
        
        if IsDisconnected() then
            print("⏳ Toujours déconnecté...")
            continue
        end
        
        -- Vérifier si le jeu est chargé
        if IsCharacterLoaded() and game:IsLoaded() then
            print("✅ Reconnection réussie !")
            Stats.RejoinCount = (Stats.RejoinCount or 0) + 1
            SendWebhook(
                string.format("✅ **Reconnection réussie !**\nTentative #%d", RejoinAttempts),
                WebhookConfig.Colors.Success,
                "✅ Reconnection Réussie",
                nil,
                WebhookConfig.PingConfig.OnRejoinSuccess
            )
            IsReconnecting = false
            RejoinAttempts = 0
            
            -- Redémarrer le farming si arrêté (avec anti-doublon)
            if not IsScriptRunning and not IsRestarting and not IsCharacterChanging then
                print("🔄 Redémarrage du farming...")
                task.wait(2)
                StartMainLoop()
            end
            return true
        end
    end
    
    print("⏰ Timeout - Nouvelle tentative...")
    IsReconnecting = false
    task.wait(3)
    return Rejoin()
end

