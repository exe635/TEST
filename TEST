local MainLoopThread = nil

function StartMainLoop()
    -- Anti-doublon
    if IsScriptRunning then
        print("⚠️ Script déjà en cours, ignoré")
        return
    end
    
    if IsRestarting then
        print("⚠️ Redémarrage en cours, ignoré")
        return
    end
    
    if IsCharacterChanging then
        print("⚠️ Changement de personnage en cours, ignoré")
        return
    end
    
    if not IsCharacterLoaded() then
        print("⚠️ Personnage non chargé, attente...")
        return
    end
    
    -- Marquer comme en cours
    IsScriptRunning = true
    IsDead = false
    
    print("✅ Script démarré en mode MIXTE (SANS AUCUN DELAI) !")
    
    local timeSinceLastReport = tick() - Stats.LastReportTime
    if timeSinceLastReport < 300 then
        local timeLeft = 300 - timeSinceLastReport
        print(string.format("⏳ Prochain rapport dans %.0f secondes", timeLeft))
    else
        print("⏳ Un rapport va être envoyé prochainement")
    end
    
    -- Annuler l'ancien thread
    if MainLoopThread then
        task.cancel(MainLoopThread)
        MainLoopThread = nil
    end
    
    MainLoopThread = task.spawn(function()
        local loopCount = 0
        while IsScriptRunning do
            -- Attendre UNIQUEMENT le heartbeat (pas de wait supplémentaires)
            RunService.Heartbeat:Wait();
            
            if not Players:FindFirstChild(Player.Name) then
                print("🚪 Joueur disparu - Arrêt du script")
                IsScriptRunning = false
                break
            end
            
            -- Si le personnage a changé, on arrête proprement
            if IsCharacterChanging then
                print("🔄 Personnage en cours de changement - Arrêt du script")
                IsScriptRunning = false
                break
            end
            
            local success, err = pcall(FarmGift);
            if not success then
                if not string.find(tostring(err), "PathfindingService") and not string.find(tostring(err), "Workspace") then
                    print("❌ Erreur FarmGift:", err)
                end
                -- PAS DE DELAI ICI
            end
            
            loopCount = loopCount + 1
            
            if loopCount % 10 == 0 then
                GetCoins()
            end
            
            if tick() - Stats.LastReportTime >= 300 then
                SendPeriodicReport(false)
            end
        end
        IsScriptRunning = false
        MainLoopThread = nil
        print("🛑 Script arrêté")
    end)
end

function StopScript()
    print("🛑 Arrêt du script...")
    IsScriptRunning = false
    IsDead = false
    
    if MainLoopThread then
        task.cancel(MainLoopThread)
        MainLoopThread = nil
    end
    
    print("✅ Script arrêté")
    print(string.format("📊 Stats sauvegardées: %d cadeaux/mineables au total", Stats.GiftsCollected))
end

function RestartScript()
    -- Anti-doublon
    if IsRestarting then
        print("⚠️ Redémarrage déjà en cours, ignoré")
        return
    end
    
    if IsCharacterChanging then
        print("⚠️ Changement de personnage en cours, ignoré")
        return
    end
    
    IsRestarting = true
    print("🔄 Redémarrage du script...")
    
    -- Arrêter proprement
    IsScriptRunning = false
    if MainLoopThread then
        task.cancel(MainLoopThread)
        MainLoopThread = nil
    end
    
    task.wait(1)
    
    -- Attendre que le personnage soit chargé
    local attempts = 0
    while attempts < 30 and not IsCharacterLoaded() do
        task.wait(0.2)
        attempts = attempts + 1
    end
    
    if IsCharacterLoaded() then
        -- Réinitialiser l'état
        IsScriptRunning = false
        IsDead = false
        StartMainLoop()
    else
        print("⚠️ Impossible de redémarrer")
    end
    
    IsRestarting = false
end

