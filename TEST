local function GetGifts()
    local Gifts = DebrisClient:GetChildren();
    local Mdx = #Gifts;
    for _ = 1, Mdx do
        local Gift = Gifts[_];
        if (not Gift) then break; end;
        local canGo = false
        local ok, result = pcall(function()
            return CanGoTo(Gift.HitDetect.Position)
        end)
        if ok and result then
            canGo = true
        end
        
        if (Gift.Name ~= "GiftPrefab" or not Gift:FindFirstChild("Top") or not Gift:FindFirstChild("HitDetect") or not canGo) then
            table.remove(Gifts, _);
            _ = _ - 1;
            Mdx = Mdx - 1;
        end;
    end;
    return Gifts;
end;

local function GetGiftDistance(Gift)
    if (not Gift) then return math.huge; end;
    local HitDetect = Gift:FindFirstChild("HitDetect");
    if (not HitDetect) then return math.huge; end;
    local char = Player.Character
    if not char then return math.huge end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return math.huge end
    return (hrp.Position - HitDetect.Position).Magnitude;
end;

-- ============================================
-- FONCTION getnearestgifts() - MIXTE (priorité au plus proche)
-- ============================================

local function getnearestgifts()
    local allTargets = {}
    
    -- 1. Récupérer tous les Mineables disponibles
    local mineables = Mineables:GetChildren()
    for _, mineable in ipairs(mineables) do
        if mineable and mineable:FindFirstChild("Highlight") then
            local canGo = false
            local ok, result = pcall(function()
                return CanGoTo(mineable.Highlight.Position)
            end)
            if ok and result then
                canGo = true
            end
            if canGo then
                table.insert(allTargets, {
                    instance = mineable,
                    type = "mineable",
                    hitDetect = mineable.Highlight
                })
            end
        end
    end
    
    -- 2. Récupérer tous les cadeaux (GiftPrefab)
    local gifts = GetGifts()
    for _, gift in ipairs(gifts) do
        if gift and gift:FindFirstChild("HitDetect") then
            table.insert(allTargets, {
                instance = gift,
                type = "gift",
                hitDetect = gift.HitDetect
            })
        end
    end
    
    -- 3. Si aucun target trouvé
    if #allTargets == 0 then
        return nil, "aucun"
    end
    
    -- 4. Trouver le plus proche (peu importe le type)
    local char = Player.Character
    if not char then return nil, "aucun" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, "aucun" end
    
    local closest = allTargets[1]
    local closestDist = (hrp.Position - closest.hitDetect.Position).Magnitude
    
    for i = 2, #allTargets do
        local target = allTargets[i]
        local dist = (hrp.Position - target.hitDetect.Position).Magnitude
        if dist < closestDist and dist > 4 then
            closestDist = dist
            closest = target
        end
    end
    
    return closest.instance, closest.type
end;

