local function FarmGift()
    local char = Player.Character
    if not char then 
        return 
    end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
        if not IsDead then
            IsDead = true
            Stats.DeathCount = (Stats.DeathCount or 0) + 1
            print("💀 Joueur mort ! Attente du respawn...")
            SendWebhook(
                "💀 **Joueur mort !**\nAttente du respawn...",
                WebhookConfig.Colors.Death,
                "💀 Mort",
                nil,
                WebhookConfig.PingConfig.OnDeath
            )
        end
        return
    end
    
    if IsDead then
        IsDead = false
        print("✅ Joueur réanimé !")
    end
    
    if not char:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    if humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
        task.wait(0.5)
        return
    end
    
    local Gift = GetNearestGift();
    if not Gift then 
        return; 
    end;
    
    local HitDetect = Gift:FindFirstChild("HitDetect") or Gift:FindFirstChild("Highlight");
    if not HitDetect or not HitDetect:IsA("BasePart") then 
        return; 
    end;
    
    local success = Goto(HitDetect.Position, Gift)
    if success and Gift.Name ~= "GiftPrefab" then
        Stats.GiftsCollected = Stats.GiftsCollected + 1
        Stats.GiftsThisPeriod = Stats.GiftsThisPeriod + 1
        wait(3);
    end;
end;

