-- ============================================
-- FONCTION PRINCIPALE DE FARM (ZÉRO DÉLAI)
-- ============================================

local function FarmGift()
    -- === 1. METTRE À JOUR LE CACHE ===
    local char = Player.Character
    if char then
        CachedCharacter = char
        CachedHRP = char:FindFirstChild("HumanoidRootPart")
    end
    
    -- === 2. VÉRIFICATIONS RAPIDES ===
    if IsCharacterChanging then return end
    
    if not CachedCharacter then return end
    
    local humanoid = CachedCharacter:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if humanoid.Health <= 0 then
        if not IsDead then
            IsDead = true
            Stats.DeathCount = (Stats.DeathCount or 0) + 1
        end
        return
    end
    
    if IsDead then
        IsDead = false
    end
    
    if not CachedHRP then return end
    
    -- === 3. GESTION DES CHANGEMENTS DE PIÈCE ===
    local currentTime = tick()
    
    -- Incrémenter le compteur de changements
    RoomSwitchCount = RoomSwitchCount + 1
    
    -- On change de pièce à chaque fois (MaxSwitches = 1)
    if (RoomSwitchCount >= MaxSwitches) then
        RoomSwitchCount = 0
        LastRoomPosition = nil -- Force un changement de pièce
        ForceRoomChange = true
        Stats.RoomSwitches = (Stats.RoomSwitches or 0) + 1
    end
    
    -- Changement de pièce à chaque appel (pas de condition de modulo)
    if ForceRoomChange and currentTime - RoomChangeCooldown > RoomChangeCooldownTime then
        -- Essaie d'obtenir une position dans une autre pièce
        local RandomPos = GetRandomRoomPosition()
        
        if RandomPos then
            RoomChangeCooldown = currentTime
            ForceRoomChange = false
            local distance = (CachedHRP.Position - RandomPos).Magnitude
            local Gift = GetNearestGift()
            if (Gift and Goto(RandomPos, Gift)) then
                -- Succès du déplacement vers une autre pièce
                return
            end
        else
            -- Si aucune autre pièce n'est disponible, on réinitialise
            ForceRoomChange = false
        end
    end
    
    -- === 4. RÉCUPÉRER LE GIFT LE PLUS PROCHE ===
    local Gift = GetNearestGift()
    if (not Gift) then return end
    
    -- === 5. RÉCUPÉRER LE HITDETECT ===
    local HitDetect = Gift:FindFirstChild("HitDetect") or Gift:FindFirstChild("Highlight")
    if (not HitDetect or not HitDetect:IsA("BasePart")) then return end
    
    -- === 6. ALLER VERS LE GIFT ===
    if (Goto(HitDetect.Position, Gift) and Gift.Name ~= "GiftPrefab") then
        Stats.GiftsCollected = Stats.GiftsCollected + 1
        Stats.GiftsThisPeriod = Stats.GiftsThisPeriod + 1
    end
end

