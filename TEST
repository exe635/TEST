-- Status global (fusionné)
_G.Status = function()
    local timeSinceLastReport = tick() - Stats.LastReportTime
    local timeLeft = math.max(0, 300 - timeSinceLastReport)
    local coins, text = GetCoins()
    local hasPopup = HasErrorPopup()
    local disconnected = IsDisconnected()
    local onScreen = IsOnDisconnectScreen()
    
    print("=== STATUT GLOBAL ===")
    print("Script farming: " .. tostring(IsScriptRunning))
    print("💀 Mort: " .. tostring(IsDead))
    print("Personnage chargé: " .. tostring(IsCharacterLoaded()))
    print("🎁 Total cadeaux: " .. Stats.GiftsCollected)
    print("🎁 Cadeaux période: " .. Stats.GiftsThisPeriod)
    print("💀 Morts: " .. (Stats.DeathCount or 0))
    print("🔄 Reconnections: " .. (Stats.RejoinCount or 0))
    print("🚪 Kicks: " .. (Stats.KickCount or 0))
    print("🌐 Erreurs réseau: " .. (Stats.NetworkErrors or 0))
    print("💰 Pièces: " .. text)
