    end)
    
    if not ok then return false end
    return (#result > 0 and result)
end

-- ============================================
-- FONCTION POUR DÉTERMINER SI DEUX POSITIONS SONT DANS LA MÊME PIÈCE
-- ============================================

local function IsSameRoom(pos1, pos2)
    if not pos1 or not pos2 then return false end
    local distance = (pos1 - pos2).Magnitude
    return distance < RoomDistanceThreshold
end

-- ============================================
-- FONCTION POUR OBTENIR UNE POSITION ALÉATOIRE DANS UNE AUTRE PIÈCE
-- ============================================

local function GetRandomRoomPosition()
    local AllGifts = DebrisClient:GetChildren()
    local ValidGifts = {}
    
    -- Récupère tous les cadeaux valides
    for _, Gift in ipairs(AllGifts) do
        if (Gift.Name == "GiftPrefab" and Gift:FindFirstChild("HitDetect")) then
            local HitDetect = Gift:FindFirstChild("HitDetect")
            if (HitDetect) then
                local canGo = false
                local ok, result = pcall(function()
                    return CanGoTo(HitDetect.Position)
                end)
                if ok and result then
                    canGo = true
                end
                if canGo then
                    table.insert(ValidGifts, {
                        Gift = Gift,
                        Position = HitDetect.Position,
                        Id = tostring(Gift)
                    })
                end
            end
        end
    end
    
    -- Ajoute aussi les mineables
    for _, Mineable in ipairs(Mineables:GetChildren()) do
        if Mineable and Mineable:FindFirstChild("Highlight") then
            local Highlight = Mineable:FindFirstChild("Highlight")
            if Highlight then
                local canGo = false
                local ok, result = pcall(function()
                    return CanGoTo(Highlight.Position)
                end)
                if ok and result then
                    canGo = true
                end
                if canGo then
                    table.insert(ValidGifts, {
                        Gift = Mineable,
                        Position = Highlight.Position,
                        Id = "Mineable_" .. tostring(Mineable)
                    })
                end
            end
        end
    end
    
    if (#ValidGifts == 0) then return nil end
    
    -- Filtrer pour éviter la même pièce (basé sur la distance)
    local DifferentRooms = {}
    for _, GiftData in ipairs(ValidGifts) do
        local isSame = false
        if LastRoomPosition then
            if IsSameRoom(GiftData.Position, LastRoomPosition) then
                isSame = true
            end
        end
        if not isSame then
            table.insert(DifferentRooms, GiftData)
        end
    end
    
    -- Si toutes les pièces sont identiques, prends une autre au hasard
    if (#DifferentRooms == 0) then
        DifferentRooms = ValidGifts
    end
    
    -- Choisir un cadeau aléatoire
    local RandomIndex = math.random(1, #DifferentRooms)
    local SelectedGift = DifferentRooms[RandomIndex]
    
    -- Mettre à jour l'historique
    table.insert(RoomHistory, SelectedGift.Position)
    if (#RoomHistory > MaxRoomHistory) then
        table.remove(RoomHistory, 1)
    end
    LastRoomPosition = SelectedGift.Position
    CurrentRoomTarget = SelectedGift.Gift
    
    return SelectedGift.Position
end

