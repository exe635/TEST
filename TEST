        end
        
        -- Réinitialiser l'état de mort
        IsDead = false
        
        print("⏳ Attente du chargement du nouveau personnage...")
        
        -- Attendre que le personnage soit vraiment prêt
        task.wait(2)
        
        -- Attendre que le Humanoid soit présent
        local humanoid = character:WaitForChild("Humanoid", 5)
        if humanoid then
            -- Attendre que le personnage soit complètement chargé
            local waitTime = 0
            while waitTime < 30 and not IsCharacterLoaded() do
                task.wait(0.2)
                waitTime = waitTime + 1
            end
        end
        
        -- Fin du changement de personnage
        IsCharacterChanging = false
        
        -- Vérifier si le personnage est chargé et prêt
        if IsCharacterLoaded() then
            print("✅ Nouveau personnage chargé !")
            
            -- Attendre un peu pour que tout se stabilise
            task.wait(1)
            
            -- RELANCER LE SCRIPT
            if not IsScriptRunning and not IsRestarting then
                print("🔄 Relance du script avec le nouveau personnage...")
                StartMainLoop()
            else
                print("⚠️ Script déjà en cours ou redémarrage en cours")
            end
        else
            print("⚠️ Nouveau personnage pas complètement chargé")
        end
    end)
end

