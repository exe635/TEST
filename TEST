local function GetGifts()
    local Gifts = DebrisClient:GetChildren();
    local Mdx = #Gifts;
    for _ = 1, Mdx do
        local Gift = Gifts[_];
        if (not Gift) then break; end;
        local canGo = false
        local ok, result = pcall(function()
            return CanGoTo(Gift.HitDetect.Position)
        end)
        if ok and result then
            canGo = true
        end
        
        if (Gift.Name ~= "GiftPrefab" or not Gift:FindFirstChild("Top") or not Gift:FindFirstChild("HitDetect") or not canGo) then
            table.remove(Gifts, _);
            _ = _ - 1;
            Mdx = Mdx - 1;
        end;
    end;
    return Gifts;
end;

local function GetGiftDistance(Gift)
    if (not Gift) then return math.huge; end;
    local HitDetect = Gift:FindFirstChild("HitDetect");
    if (not HitDetect) then return math.huge; end;
    local char = Player.Character
    if not char then return math.huge end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return math.huge end
    return (hrp.Position - HitDetect.Position).Magnitude;
end;

local function GetNearestGift()
    local Mineable = Mineables:GetChildren()[1];
    if (Mineable and Mineable:FindFirstChild("Highlight")) then
        local canGo = false
        local ok, result = pcall(function()
            return CanGoTo(Mineable.Highlight.Position)
        end)
        if ok and result then
            canGo = true
        end
        if canGo then
            return Mineable;
        end
    end;
    
    local Gifts = GetGifts();
    if #Gifts == 0 then return nil end
    
    local ClosestGift = Gifts[1];
    local ClosestDist = GetGiftDistance(ClosestGift);

    for _ = 2, #Gifts do
        local Gift = Gifts[_];
        local Dist = GetGiftDistance(Gift);
        if (Dist < ClosestDist and Dist > 4) then
            ClosestDist = Dist;
            ClosestGift = Gift;
        end;
    end;
    
    return ((ClosestDist ~= math.huge) and ClosestGift);
end;

local function Goto(Target, Gift)
    local ok, result = pcall(function()
        local Path = PathfindingService:CreatePath({
            AgentCanClimb = true;
            WaypointSpacing = 1;
        });
        local HumanoidRootPart = Player.Character.HumanoidRootPart
        Path:ComputeAsync(HumanoidRootPart.Position, Target);
        return Path:GetWaypoints(HumanoidRootPart.Position);
    end)
    
    if not ok then
        return false
    end
    
    local Points = result
    if #Points == 0 then return false end
    
    for _ = 1, #Points do
        if (not Points[_ + 1]) then break; end;
        local New = Points[_].Position;
        local Next = Points[_ + 1].Position;
        local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        if ((hrp.Position - New).Magnitude > 10) then return false; end;
        ImprovedTeleport(Vector3.new(New.X, math.max(Next.Y, New.Y) + 3, New.Z));
    end;

    ImprovedTeleport(Points[#Points].Position + Vector3.new(0, 3, 0));
    return true
end;

local function IsCharacterLoaded()
    local char = Player.Character;
    if not char then return false end
    if not char.Parent then return false end
    local humanoid = char:FindFirstChild("Humanoid");
    if not humanoid or humanoid.Health == nil then return false end
    if humanoid.Health <= 0 then return false end
    return char:FindFirstChild("HumanoidRootPart") ~= nil
end

