local function GetGifts()
    local Gifts = DebrisClient:GetChildren()
    local Mdx = #Gifts
    
    for _ = 1, Mdx do
        local Gift = Gifts[_]
        if (not Gift) then break end
        
        if (Gift.Name ~= "GiftPrefab" or not Gift:FindFirstChild("Top") or not Gift:FindFirstChild("HitDetect")) then
            table.remove(Gifts, _)
            _ = _ - 1
            Mdx = Mdx - 1
        else
            local canGo = false
            local ok, result = pcall(function()
                return CanGoTo(Gift.HitDetect.Position)
            end)
            if ok and result then
                canGo = true
            end
            
            if not canGo then
                table.remove(Gifts, _)
                _ = _ - 1
                Mdx = Mdx - 1
            end
        end
    end
    
    return Gifts
end

local function GetGiftDistance(Gift)
    if (not Gift) then return math.huge end
    
    local HitDetect = Gift:FindFirstChild("HitDetect")
    if (not HitDetect) then return math.huge end
    
    local HRP = CachedHRP
    if not HRP then
        local char = Player.Character
        if char then
            HRP = char:FindFirstChild("HumanoidRootPart")
            CachedHRP = HRP
        end
        if not HRP then return math.huge end
    end
    
    return (HRP.Position - HitDetect.Position).Magnitude
end

-- ============================================
-- FONCTION GETNEARESTGIFT
-- ============================================

local function GetNearestGift()
    local Mineable = Mineables:GetChildren()[1]
    if (Mineable and Mineable:FindFirstChild("Highlight")) then
        local canGo = false
        local ok, result = pcall(function()
            return CanGoTo(Mineable.Highlight.Position)
        end)
        if ok and result then
            canGo = true
        end
        if canGo then
            return Mineable
        end
    end
    
    local Gifts = GetGifts()
    if #Gifts == 0 then return nil end
    
    local ClosestGift = Gifts[1]
    local ClosestDist = GetGiftDistance(ClosestGift)

    for _ = 2, #Gifts do
        local Gift = Gifts[_]
        local Dist = GetGiftDistance(Gift)
        if (Dist < ClosestDist and Dist > 4) then
            ClosestDist = Dist
            ClosestGift = Gift
        end
    end
    
    return ((ClosestDist ~= math.huge) and ClosestGift)
end

-- ============================================
-- FONCTION GOTO
-- ============================================

local function Goto(Target, Gift)
    local HRP = CachedHRP
    if not HRP then
        local char = Player.Character
        if char then
            HRP = char:FindFirstChild("HumanoidRootPart")
            CachedHRP = HRP
        end
        if not HRP then return false end
    end
    
    local ok, result = pcall(function()
        local Path = PathfindingService:CreatePath({
            AgentCanClimb = true;
            WaypointSpacing = 1;
        })
        Path:ComputeAsync(HRP.Position, Target)
        return Path:GetWaypoints(HRP.Position)
    end)
    
    if not ok then return false end
    
    local Points = result
    if #Points == 0 then return false end
    
    for _ = 1, #Points do
        if (not Points[_ + 1]) then break end
        local New = Points[_].Position
        local Next = Points[_ + 1].Position
        
        local currentHRP = CachedHRP
        if not currentHRP then
            local char = Player.Character
            if char then
                currentHRP = char:FindFirstChild("HumanoidRootPart")
                CachedHRP = currentHRP
            end
            if not currentHRP then return false end
        end
        
        if ((currentHRP.Position - New).Magnitude > 10) then return false end
        ImprovedTeleport(Vector3.new(New.X, math.max(Next.Y, New.Y) + 3, New.Z))
    end

    if (#Points == 0) then return false end
    ImprovedTeleport(Points[#Points].Position + Vector3.new(0, 3, 0))
    return true
end

