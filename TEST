-- Détection des erreurs via GuiService
local LastErrorTime = 0

GuiService.ErrorMessageChanged:Connect(function(errorMessage)
    if errorMessage and errorMessage ~= "" then
        local now = tick()
        if now - LastErrorTime < 2 then
            return
        end
        LastErrorTime = now
        
        print("⚠️ ERREUR GUI: " .. errorMessage)
        
        local lowerMsg = string.lower(errorMessage)
        
        if string.find(lowerMsg, "connection failed") or
           string.find(lowerMsg, "lost connection") or
           string.find(lowerMsg, "disconnected") or
           string.find(lowerMsg, "teleport failed") or
           string.find(lowerMsg, "http error") or
           string.find(lowerMsg, "raiseteleportinitfailedevent") then
            
            -- Ne pas rejoin si mort
            if not IsDead and not IsReconnecting and RejoinActive then
                print("🔄 Lancement auto-rejoin dans 2 secondes...")
                task.wait(2)
                Rejoin()
            end
        end
    end
end)

