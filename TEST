local function GetDiscordTimestamp()
    local now = os.time()
    return string.format("%04d-%02d-%02dT%02d:%02d:%02dZ",
        os.date("%Y", now),
        os.date("%m", now),
        os.date("%d", now),
        os.date("%H", now),
        os.date("%M", now),
        os.date("%S", now)
    )
end

local function GetLocalTime()
    return os.date("%H:%M:%S")
end

local function CreatePing(UserID)
    if not UserID or UserID == "" then return "" end
    return "<@" .. UserID .. ">"
end

local function IsWebhookValid()
    if not WebhookConfig.Enabled then return false end
    if not WebhookConfig.URL or WebhookConfig.URL == "" then return false end
    if not string.find(WebhookConfig.URL, "discord.com/api/webhooks/") then return false end
    return true
end

local function SendWebhook(Message, Color, Title, Fields, ShouldPing)
    if not IsWebhookValid() then return false end
    
    local UserID = WebhookConfig.PingConfig.UserID
    local PingText = ""
    
    if ShouldPing and UserID and UserID ~= "" and UserID ~= "1532693233124249781" then
        PingText = CreatePing(UserID) .. " "
    end
    
    local Data = {
        embeds = {{
            title = Title or "📢 Notification",
            description = PingText .. Message,
            color = Color or WebhookConfig.Colors.Info,
            fields = Fields or {},
            footer = {
                text = "Script Auto-Farm | " .. GetLocalTime()
            },
            timestamp = GetDiscordTimestamp()
        }}
    }
    
    local playerName = Player and Player.Name or "Inconnu"
    local playerId = Player and Player.UserId or 0
    
    if not Title then
        Data.embeds[1].author = {
            name = playerName,
            icon_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. playerId .. "&width=420&height=420&format=png"
        }
    end
    
    local success, response = pcall(function()
        local request = nil
        
        if syn and syn.request then
            request = syn.request
        elseif http and http.request then
            request = http.request
        elseif HttpService and HttpService.PostAsync then
            local json = HttpService:JSONEncode(Data)
            return HttpService:PostAsync(WebhookConfig.URL, json, Enum.HttpContentType.ApplicationJson)
        else
            return false
        end
        
        if request then
            local response = request({
                Url = WebhookConfig.URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(Data)
            })
            
            if response and response.StatusCode then
                return response.StatusCode >= 200 and response.StatusCode < 300
            end
        end
        return false
    end)
    
    if success and response then
        return true
    else
        return false
    end
end

