local function Goto(Target, Gift)
    local ok, result = pcall(function()
        local Path = PathfindingService:CreatePath({
            AgentCanClimb = true;
            WaypointSpacing = 1;
        });
        local HumanoidRootPart = Player.Character.HumanoidRootPart
        Path:ComputeAsync(HumanoidRootPart.Position, Target);
        return Path:GetWaypoints(HumanoidRootPart.Position);
    end)
    
    if not ok then
        return false
    end
    
    local Points = result
    if #Points == 0 then return false end
    
    for _ = 1, #Points do
        if (not Points[_ + 1]) then break; end;
        local New = Points[_].Position;
        local Next = Points[_ + 1].Position;
        local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        if ((hrp.Position - New).Magnitude > 10) then return false; end;
        ImprovedTeleport(Vector3.new(New.X, math.max(Next.Y, New.Y) + 3, New.Z));
    end;

    ImprovedTeleport(Points[#Points].Position + Vector3.new(0, 3, 0));
    return true
end;

local function IsCharacterLoaded()
    local char = Player.Character;
    if not char then return false end
    if not char.Parent then return false end
    local humanoid = char:FindFirstChild("Humanoid");
    if not humanoid or humanoid.Health == nil then return false end
    if humanoid.Health <= 0 then return false end
    return char:FindFirstChild("HumanoidRootPart") ~= nil
end

